{
  "info": {
    "name": "Blog Platform API",
    "description": "Complete collection for the Blog Platform REST API built with Node.js, Express, MongoDB and Mongoose. Organized into User, Post, and Comment folders. Includes test cases for successful requests, validation failures, duplicate email handling, and cascading deletes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "secondUserId", "value": "", "type": "string" },
    { "key": "postId", "value": "", "type": "string" },
    { "key": "commentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('userId', data.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmad Sufyan\",\n  \"email\": \"ahmad.sufyan@example.com\",\n  \"password\": \"secret123\",\n  \"bio\": \"MERN stack intern at The Tech Pulses.\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
          }
        },
        {
          "name": "Register Second User (for comments/testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('secondUserId', data.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Ahmed\",\n  \"email\": \"sara@example.com\",\n  \"password\": \"secret123\",\n  \"bio\": \"Frontend enthusiast.\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
          }
        },
        {
          "name": "Register User (duplicate email -> 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmad Duplicate\",\n  \"email\": \"ahmad.sufyan@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
          }
        },
        {
          "name": "Register User (invalid input -> 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('errors array present', () => pm.expect(pm.response.json().errors).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad.sufyan@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] }
          }
        },
        {
          "name": "Login User (wrong password -> 401)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad.sufyan@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] }
          }
        },
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get User By ID (with published posts populated)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated bio: MERN stack intern at The Tech Pulses, exploring cybersecurity on the side.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Delete User (verifies cascading delete of posts + comments)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{secondUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{secondUserId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post (Tech)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('postId', data.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Express Middleware\",\n  \"content\": \"Middleware functions are the backbone of any Express application. This post walks through how request/response cycles flow through them.\",\n  \"category\": \"Tech\",\n  \"tags\": [\"nodejs\", \"express\"],\n  \"author\": \"{{userId}}\",\n  \"isPublished\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Create Post (Lifestyle)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Balancing Internship and University Life\",\n  \"content\": \"Managing a MERN internship alongside coursework takes discipline. Here is how I structure my week to fit both in.\",\n  \"category\": \"Lifestyle\",\n  \"tags\": [\"productivity\", \"internship\"],\n  \"author\": \"{{userId}}\",\n  \"isPublished\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Create Post (Education, unpublished)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Understanding Mongoose Population\",\n  \"content\": \"Population lets you reference documents in other collections and swap the id for the actual document data.\",\n  \"category\": \"Education\",\n  \"tags\": [\"mongodb\", \"mongoose\"],\n  \"author\": \"{{userId}}\",\n  \"isPublished\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Create Post (invalid input -> 400)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hi\",\n  \"content\": \"short\",\n  \"category\": \"NotARealCategory\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Get All Published Posts",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Get Posts - filter by category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?category=Tech",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "category", "value": "Tech" }]
            }
          }
        },
        {
          "name": "Get Posts - filter by tag",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?tag=nodejs",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "tag", "value": "nodejs" }]
            }
          }
        },
        {
          "name": "Get Posts - search keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?search=middleware",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "search", "value": "middleware" }]
            }
          }
        },
        {
          "name": "Get Posts - sort popular",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?sort=popular",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "sort", "value": "popular" }]
            }
          }
        },
        {
          "name": "Get All Posts (admin, includes unpublished)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/all", "host": ["{{baseUrl}}"], "path": ["posts", "all"] }
          }
        },
        {
          "name": "Get Post By ID (author + comments populated)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        },
        {
          "name": "Update Post",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Express Middleware (Updated)\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        },
        {
          "name": "Like Post",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/like",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}", "like"]
            }
          }
        },
        {
          "name": "Toggle Publish Post",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}", "publish"]
            }
          }
        },
        {
          "name": "Delete Post (verifies cascading delete of comments)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('commentId', data.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Great explanation, this cleared up a lot of confusion.\",\n  \"author\": \"{{secondUserId}}\",\n  \"post\": \"{{postId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/comments", "host": ["{{baseUrl}}"], "path": ["comments"] }
          }
        },
        {
          "name": "Add Comment (invalid input -> 400)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"x\"\n}" },
            "url": { "raw": "{{baseUrl}}/comments", "host": ["{{baseUrl}}"], "path": ["comments"] }
          }
        },
        {
          "name": "Get Comments By Post (author name populated)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/comments/post/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "post", "{{postId}}"]
            }
          }
        },
        {
          "name": "Update Comment",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Edited: great explanation, this cleared up a lot of confusion for me.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}"]
            }
          }
        },
        {
          "name": "Delete Comment",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{commentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Handling Checks",
      "item": [
        {
          "name": "Invalid ObjectId -> 400 (not 500)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/12345", "host": ["{{baseUrl}}"], "path": ["posts", "12345"] }
          }
        },
        {
          "name": "Unknown Route -> 404 JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Response is JSON', () => pm.response.headers.get('Content-Type').includes('application/json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/this-route-does-not-exist", "host": ["{{baseUrl}}"], "path": ["this-route-does-not-exist"] }
          }
        }
      ]
    }
  ]
}
